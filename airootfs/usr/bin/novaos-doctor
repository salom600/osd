#!/usr/bin/env bash
# =============================================================================
# novaos-doctor - Diagnostic + repair tool
# =============================================================================
# Checks system health and offers to fix common issues:
#   - Disk space
#   - Failed systemd services
#   - Broken pacman database
#   - Missing firmware
#   - Graphics driver status
#   - Network connectivity
#
set -euo pipefail

GREEN='\033[1;32m'; RED='\033[1;31m'; YELL='\033[1;33m'; BLUE='\033[1;34m'; RST='\033[0m'
ok()   { echo -e "  ${GREEN}✓${RST} $*"; }
fail() { echo -e "  ${RED}✗${RST} $*"; }
warn() { echo -e "  ${YELL}!${RST} $*"; }
hdr()  { echo -e "\n${BLUE}== $* ==${RST}"; }

hdr "NovaOS Doctor - System Health Check"

# 1. Disk space
hdr "Disk space"
df -h / | awk 'NR==2 {printf "  / usage: %s of %s (%s)\n", $3, $2, $5}'
USAGE_PCT=$(df / | awk 'NR==2 {gsub(/%/,""); print $5}')
if [ "$USAGE_PCT" -gt 90 ]; then
    fail "Root filesystem is more than 90% full"
    echo "    Suggested: sudo novaos-update  (cleans pacman cache)"
    echo "    Or:        sudo paccache -rk1"
else
    ok "Root filesystem has space available"
fi

# 2. Failed systemd services
hdr "Systemd services"
FAILED=$(systemctl --failed --no-legend --no-pager 2>/dev/null | awk '{print $1}')
if [ -n "$FAILED" ]; then
    fail "Failed services:"
    echo "$FAILED" | sed 's/^/    - /'
    echo
    read -r -p "  Attempt to restart failed services? [y/N] " REPLY
    if [[ "$REPLY" =~ ^[Yy]$ ]]; then
        echo "$FAILED" | xargs -r sudo systemctl restart 2>/dev/null || true
        ok "Restart attempted"
    fi
else
    ok "No failed systemd services"
fi

# 3. Pacman database integrity
hdr "Pacman database"
if sudo pacman -Dk 2>/dev/null; then
    ok "Pacman database is consistent"
else
    fail "Pacman database has issues"
    warn "Run: sudo pacman -Syyu  to resync"
fi

# 4. Network
hdr "Network"
if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then
    ok "Internet connectivity: OK"
else
    fail "No internet connectivity"
    warn "Check: sudo systemctl restart NetworkManager"
fi

# 5. Graphics
hdr "Graphics"
if command -v lspci >/dev/null 2>&1; then
    GPU=$(lspci | grep -iE 'vga|3d|display' | head -1 | sed 's/.*: //')
    echo "  Detected GPU: $GPU"
fi
if command -v glxinfo >/dev/null 2>&1; then
    RENDERER=$(glxinfo | grep "OpenGL renderer string" | cut -d: -f2 | xargs)
    ok "OpenGL renderer: $RENDERER"
else
    warn "glxinfo not available - install mesa-utils for full diagnostics"
fi

# 6. Kernel version
hdr "Kernel"
KVER=$(uname -r)
echo "  Running kernel: $KVER"
INSTALLED=$(pacman -Q linux 2>/dev/null | cut -d' ' -f2 || echo "unknown")
echo "  Installed pkg:  linux $INSTALLED"
if [[ "$KVER" != "$INSTALLED"* ]]; then
    warn "Running kernel != installed version - reboot to apply updates"
fi

# 7. Firmware
hdr "Firmware"
if [ -d /sys/firmware/efi ]; then
    echo "  Boot mode: UEFI"
    if command -v efibootmgr >/dev/null 2>&1; then
        efibootmgr | grep -E 'BootOrder|BootCurrent' | sed 's/^/    /'
    fi
else
    echo "  Boot mode: BIOS/Legacy"
fi

hdr "Done"
echo "  For more help: https://github.com/salom600/osd/issues"
