[org.kde.kdecoration2]
library=org.kde.novaos
theme=NovaOS

[Windows]
BorderlessMaximizedWindows=true

[Effect-blur]
BlurStrength=15
NoiseStrength=5
Enabled=true

[Effect-wobblywindows]
Drag=85
Stiffness=8.5
WobblynessLevel=2

[Effect-scale]
Duration=400
AnimationCurve=OutCubic

[Effect-fade]
Duration=180

[Effect-glide]
Duration=180
InRotation=15
OutRotation=-15

[Effect-squash]
Duration=180

[Effect-zoom]
Duration=200

[Compositing]
Backend=OpenGL
GLColorCorrection=true
GLCore=true
AnimationSpeed=2
HiddenPreviews=5
WindowsBlockCompositing=false
GLPreferBufferSwap=a/a

[TabBox]
LayoutName=covers
DesktopLayoutName=inverse

[Plugins]
wobblywindowsEnabled=true
blurEnabled=true
scaleEnabled=true
fadeEnabled=true
glideEnabled=true
squashEnabled=true
zoomEnabled=false
fallapartEnabled=false
magnifierEnabled=false
